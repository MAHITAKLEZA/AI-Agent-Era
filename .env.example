# Copy this file to .env and fill in your keys. Never commit .env.

# Routeriva (formerly Bay of Assets): Claude Haiku
BOA_API_KEY=
BOA_BASE_URL=https://api.routeriva.com/v1
CLAUDE_MODEL=claude-haiku-4-5

# Google Gemini (your own key, free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Crawl settings
MAX_PAGES=50
